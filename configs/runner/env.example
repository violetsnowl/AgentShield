# Copy these lines into the project-root .env (git-ignored). Only these keys are read by runners/env.py.
# B never reads .env and is always started with ENABLE_PAID_RUNS=false / MAX_COST=0.
DEEPSEEK_API_KEY=
# Xiaomi MiMo Token Plan key (tp-...) and Command Code provider key (user_...).
MIMO_TOKEN_PLAN_API_KEY=
COMMANDCODE_API_KEY=
C_ENABLE_PAID_RUNS=false
C_MAX_COST_CNY=0
