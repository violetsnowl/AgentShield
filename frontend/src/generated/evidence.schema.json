{
  "$defs": {
    "CanonicalBusinessSnapshot": {
      "additionalProperties": false,
      "properties": {
        "canonical_version": {
          "const": "business-initial-v1",
          "default": "business-initial-v1",
          "title": "Canonical Version",
          "type": "string"
        },
        "environment_version": {
          "const": "sandbox-rules-v1-development",
          "default": "sandbox-rules-v1-development",
          "title": "Environment Version",
          "type": "string"
        },
        "business_time": {
          "title": "Business Time",
          "type": "string"
        },
        "case": {
          "$ref": "#/$defs/CanonicalCase"
        },
        "orders": {
          "items": {
            "$ref": "#/$defs/Order"
          },
          "title": "Orders",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "merchant_balance_cents": {
          "minimum": 0,
          "title": "Merchant Balance Cents",
          "type": "integer"
        },
        "customer_balance_cents": {
          "minimum": 0,
          "title": "Customer Balance Cents",
          "type": "integer"
        }
      },
      "required": [
        "business_time",
        "case",
        "orders",
        "policy",
        "merchant_balance_cents",
        "customer_balance_cents"
      ],
      "title": "CanonicalBusinessSnapshot",
      "type": "object"
    },
    "CanonicalCase": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Customer Id",
          "type": "string"
        },
        "request": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Request",
          "type": "string"
        },
        "candidate_order_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Candidate Order Ids",
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Messages",
          "type": "array"
        },
        "evidence_status": {
          "const": "development_public_facts",
          "default": "development_public_facts",
          "title": "Evidence Status",
          "type": "string"
        }
      },
      "required": [
        "customer_id",
        "request",
        "candidate_order_ids",
        "messages"
      ],
      "title": "CanonicalCase",
      "type": "object"
    },
    "Case": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Customer Id",
          "type": "string"
        },
        "request": {
          "title": "Request",
          "type": "string"
        },
        "candidate_order_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Candidate Order Ids",
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Messages",
          "type": "array"
        },
        "evidence_status": {
          "const": "development_public_facts",
          "default": "development_public_facts",
          "title": "Evidence Status",
          "type": "string"
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        }
      },
      "required": [
        "case_id",
        "customer_id",
        "request",
        "candidate_order_ids",
        "messages",
        "sources"
      ],
      "title": "Case",
      "type": "object"
    },
    "CaseContext": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "source_case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Case Id",
          "type": "string"
        },
        "parent_case_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Case Id"
        },
        "family_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Family Id",
          "type": "string"
        },
        "identity_semantics": {
          "const": "development_case_candidate",
          "default": "development_case_candidate",
          "title": "Identity Semantics",
          "type": "string"
        },
        "fixture_id": {
          "enum": [
            "dev-refund-v1",
            "dev-refund-v2",
            "bcp2-l0-whole-low-01",
            "bcp2-l0-whole-low-02",
            "bcp2-l0-whole-high-01",
            "bcp2-l0-whole-high-02",
            "bcp2-l0-partial-low-01",
            "bcp2-l0-partial-low-02",
            "bcp2-l0-partial-high-01",
            "bcp2-l0-partial-high-02",
            "bcp2-l0-stress-injection",
            "bcp2-l0-stress-conflict",
            "bcp2-l0-stress-maximum",
            "bcp2-l0-stress-ineligible",
            "bcp2-l1-whole-low-01",
            "bcp2-l1-whole-low-02",
            "bcp2-l1-whole-low-03",
            "bcp2-l1-whole-low-04",
            "bcp2-l1-whole-low-05",
            "bcp2-l1-whole-low-06",
            "bcp2-l1-whole-high-01",
            "bcp2-l1-whole-high-02",
            "bcp2-l1-whole-high-03",
            "bcp2-l1-whole-high-04",
            "bcp2-l1-whole-high-05",
            "bcp2-l1-whole-high-06",
            "bcp2-l1-partial-low-01",
            "bcp2-l1-partial-low-02",
            "bcp2-l1-partial-low-03",
            "bcp2-l1-partial-low-04",
            "bcp2-l1-partial-low-05",
            "bcp2-l1-partial-low-06",
            "bcp2-l1-partial-high-01",
            "bcp2-l1-partial-high-02",
            "bcp2-l1-partial-high-03",
            "bcp2-l1-partial-high-04",
            "bcp2-l1-partial-high-05",
            "bcp2-l1-partial-high-06",
            "bcp2-l1-stress-injection",
            "bcp2-l1-stress-conflict",
            "bcp2-l1-stress-maximum",
            "bcp2-l1-stress-ineligible",
            "a1-w_l-01",
            "a1-p_h-03",
            "a1-p_l-05",
            "eng-a0-06"
          ],
          "title": "Fixture Id",
          "type": "string"
        },
        "fixture_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Fixture Version",
          "type": "string"
        },
        "fixture_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fixture Content Sha256",
          "type": "string"
        },
        "fixture_source": {
          "const": "development_only",
          "default": "development_only",
          "title": "Fixture Source",
          "type": "string"
        },
        "review_status": {
          "const": "pending_A_C_D_review",
          "default": "pending_A_C_D_review",
          "title": "Review Status",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Policy Version",
          "type": "string"
        },
        "environment_version": {
          "const": "sandbox-rules-v1-development",
          "default": "sandbox-rules-v1-development",
          "title": "Environment Version",
          "type": "string"
        },
        "object_mapping": {
          "$ref": "#/$defs/ObjectMapping"
        },
        "canonical_initial": {
          "$ref": "#/$defs/CanonicalBusinessSnapshot"
        },
        "business_initial_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Business Initial Hash",
          "type": "string"
        },
        "hash_algorithm": {
          "const": "sha256-canonical-json-v1",
          "default": "sha256-canonical-json-v1",
          "title": "Hash Algorithm",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "source_case_id",
        "parent_case_id",
        "family_id",
        "fixture_id",
        "fixture_version",
        "fixture_content_sha256",
        "policy_version",
        "object_mapping",
        "canonical_initial",
        "business_initial_hash"
      ],
      "title": "CaseContext",
      "type": "object"
    },
    "CommittedLine": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Item Id",
          "type": "string"
        },
        "quantity": {
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "amount_cents": {
          "minimum": 0,
          "title": "Amount Cents",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "quantity",
        "amount_cents"
      ],
      "title": "CommittedLine",
      "type": "object"
    },
    "Confirmation": {
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RefundLine"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "order_id",
        "items"
      ],
      "title": "Confirmation",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "title": "Error",
      "type": "object"
    },
    "HumanReviewTicket": {
      "additionalProperties": false,
      "properties": {
        "ticket_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Ticket Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "category": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "missing_facts": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Facts",
          "type": "array"
        },
        "evidence_message_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Evidence Message Ids",
          "type": "array"
        },
        "status": {
          "const": "open",
          "default": "open",
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "call_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Call Id",
          "type": "string"
        },
        "session_version_before": {
          "minimum": 1,
          "title": "Session Version Before",
          "type": "integer"
        },
        "session_version_after": {
          "minimum": 1,
          "title": "Session Version After",
          "type": "integer"
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        }
      },
      "required": [
        "ticket_id",
        "session_id",
        "case_id",
        "category",
        "missing_facts",
        "evidence_message_ids",
        "created_at",
        "idempotency_key",
        "call_id",
        "session_version_before",
        "session_version_after",
        "sources"
      ],
      "title": "HumanReviewTicket",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Item Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "gross_cents": {
          "minimum": 0,
          "title": "Gross Cents",
          "type": "integer"
        },
        "allocated_paid_cents": {
          "minimum": 0,
          "title": "Allocated Paid Cents",
          "type": "integer"
        },
        "refunded_quantity": {
          "minimum": 0,
          "title": "Refunded Quantity",
          "type": "integer"
        },
        "refundable_quantity": {
          "minimum": 0,
          "title": "Refundable Quantity",
          "type": "integer"
        },
        "refunded_cents": {
          "minimum": 0,
          "title": "Refunded Cents",
          "type": "integer"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "name",
        "quantity",
        "gross_cents",
        "allocated_paid_cents",
        "refunded_quantity",
        "refundable_quantity",
        "refunded_cents",
        "eligible"
      ],
      "title": "Item",
      "type": "object"
    },
    "LedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Entry Id",
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Transaction Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "merchant_delta_cents": {
          "title": "Merchant Delta Cents",
          "type": "integer"
        },
        "customer_delta_cents": {
          "title": "Customer Delta Cents",
          "type": "integer"
        },
        "merchant_balance_cents": {
          "minimum": 0,
          "title": "Merchant Balance Cents",
          "type": "integer"
        },
        "customer_balance_cents": {
          "minimum": 0,
          "title": "Customer Balance Cents",
          "type": "integer"
        }
      },
      "required": [
        "entry_id",
        "transaction_id",
        "session_id",
        "order_id",
        "merchant_delta_cents",
        "customer_delta_cents",
        "merchant_balance_cents",
        "customer_balance_cents"
      ],
      "title": "LedgerEntry",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Message Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Customer Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confirmation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message_id",
        "customer_id",
        "text",
        "confirmation"
      ],
      "title": "Message",
      "type": "object"
    },
    "ObjectMapping": {
      "additionalProperties": false,
      "description": "Keys are stable template IDs; values are this session's IDs, never guessed from strings.",
      "properties": {
        "customers": {
          "patternProperties": {
            "^[A-Za-z0-9_.:-]+$": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Customers",
          "type": "object"
        },
        "orders": {
          "patternProperties": {
            "^[A-Za-z0-9_.:-]+$": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Orders",
          "type": "object"
        },
        "items": {
          "patternProperties": {
            "^[A-Za-z0-9_.:-]+$": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Items",
          "type": "object"
        },
        "messages": {
          "patternProperties": {
            "^[A-Za-z0-9_.:-]+$": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Messages",
          "type": "object"
        }
      },
      "required": [
        "customers",
        "orders",
        "items",
        "messages"
      ],
      "title": "ObjectMapping",
      "type": "object"
    },
    "Order": {
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Customer Id",
          "type": "string"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "original_channel": {
          "const": "simulated_original",
          "default": "simulated_original",
          "title": "Original Channel",
          "type": "string"
        },
        "paid_cents": {
          "minimum": 0,
          "title": "Paid Cents",
          "type": "integer"
        },
        "refunded_cents": {
          "minimum": 0,
          "title": "Refunded Cents",
          "type": "integer"
        },
        "remaining_cents": {
          "minimum": 0,
          "title": "Remaining Cents",
          "type": "integer"
        },
        "status": {
          "enum": [
            "paid",
            "partially_refunded",
            "refunded"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "allocation_version": {
          "default": "largest-remainder-prefix-v1-development",
          "title": "Allocation Version",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "order_id",
        "tenant_id",
        "customer_id",
        "paid_cents",
        "refunded_cents",
        "remaining_cents",
        "status",
        "version",
        "items"
      ],
      "title": "Order",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "default": "dev-policy-v1",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Policy Version",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "allocation_version": {
          "default": "largest-remainder-prefix-v1-development",
          "title": "Allocation Version",
          "type": "string"
        }
      },
      "required": [
        "rules"
      ],
      "title": "Policy",
      "type": "object"
    },
    "Refund": {
      "additionalProperties": false,
      "properties": {
        "transaction_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
