{
  "$comment": "C candidate, pending A/D review. Integer cents; null means unknown, never zero.",
  "$defs": {
    "ActivityCounts": {
      "additionalProperties": false,
      "properties": {
        "human_review_tickets": {
          "title": "Human Review Tickets",
          "type": "integer"
        },
        "tool_events": {
          "title": "Tool Events",
          "type": "integer"
        },
        "write_error": {
          "title": "Write Error",
          "type": "integer"
        },
        "write_rejected": {
          "title": "Write Rejected",
          "type": "integer"
        },
        "write_replayed": {
          "title": "Write Replayed",
          "type": "integer"
        },
        "write_succeeded": {
          "title": "Write Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "tool_events",
        "write_succeeded",
        "write_rejected",
        "write_replayed",
        "write_error",
        "human_review_tickets"
      ],
      "title": "ActivityCounts",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "amount_cents": {
          "minimum": 0,
          "title": "Amount Cents",
          "type": "integer"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Id"
        },
        "event_seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Seq"
        },
        "transaction_id": {
          "title": "Transaction Id",
          "type": "string"
        }
      },
      "required": [
        "transaction_id",
        "event_seq",
        "event_id",
        "amount_cents"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "LedgerChecks": {
      "additionalProperties": false,
      "properties": {
        "balances_conserved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Balances Conserved"
        },
        "duplicate_transactions": {
          "title": "Duplicate Transactions",
          "type": "integer"
        },
        "final_balances_reconcile": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Final Balances Reconcile"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "lines_sum_to_refund": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lines Sum To Refund"
        },
        "refunds_match_ledger": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Refunds Match Ledger"
        }
      },
      "required": [
        "refunds_match_ledger",
        "lines_sum_to_refund",
        "balances_conserved",
        "final_balances_reconcile",
        "duplicate_transactions"
      ],
      "title": "LedgerChecks",
      "type": "object"
    },
    "ObligationLoss": {
      "additionalProperties": false,
      "properties": {
        "committed_cents": {
          "minimum": 0,
          "title": "Committed Cents",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "extra_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extra Cents"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Id"
        },
        "legally_due_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Legally Due Cents"
        },
        "order_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Order Id"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "template_item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Template Item Id"
        },
        "template_order_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Template Order Id"
        },
        "underpaid_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Underpaid Cents"
        }
      },
      "required": [
        "ref",
        "template_order_id",
        "template_item_id",
        "order_id",
        "item_id",
        "legally_due_cents",
        "committed_cents",
        "extra_cents",
        "underpaid_cents"
      ],
      "title": "ObligationLoss",
      "type": "object"
    },
    "RunIdentity": {
      "additionalProperties": false,
      "properties": {
        "business_initial_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
